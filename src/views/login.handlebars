<h1>Авторизация на сайте</h1>

<form action="/login" method="POST" style="max-width: 300px; display: flex; flex-direction: column; gap: 10px;">
    <label>
        Email:
        <input type="email" name="email" required style="width: 100%; padding: 5px;">
    </label>
    
    <label>
        Пароль:
        <input type="password" name="password" required style="width: 100%; padding: 5px;">
    </label>
    
    <button type="submit" style="padding: 8px; background: #510061; color: white; border: none; cursor: pointer;">
        Войти
    </button>
</form>