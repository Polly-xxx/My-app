<h2>Список зарегистрированных пользователей</h2>

{{#if users.length}}
  <table border="1" cellpadding="8" cellspacing="0">
    <thead>
      <tr>
        <th>Имя</th>
        <th>Email</th>
      </tr>
    </thead>
    <tbody>
      {{#each users}}
        <tr>
          <td>{{this.username}}</td>
          <td>{{this.email}}</td>
        </tr>
      {{/each}}
    </tbody>
  </table>
{{else}}
  <p>Пока нет ни одного зарегистрированного пользователя.</p>
{{/if}}

<br>
<a href="/">Вернуться на главную</a>
