<h1>Регистрация нового пользователя</h1>

{{#if error}}
    <p style="color: red; font-weight: bold;">{{error}}</p>
{{/if}}
{{#if success}}
    <p style="color: green; font-weight: bold;">{{success}}</p>
{{/if}}

<form action="/auth/register" method="POST" style="max-width: 300px; display: flex; flex-direction: column; gap: 10px;">
    <label>
        Email:
        <input type="email" name="email" required style="width: 100%; padding: 5px;">
    </label>

    <label>
        Пароль:
        <input type="password" name="password" required style="width: 100%; padding: 5px;">
    </label>

    <button type="submit" style="padding: 8px; background: #00612d; color: white; border: none; cursor: pointer;">
        Зарегистрироваться
        </button>
</form>
